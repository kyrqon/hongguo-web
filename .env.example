# Web: leave empty for the same-origin API / Vite development proxy.
# Native app builds must use an HTTPS API reachable from the device.
VITE_API_BASE_URL=

# Node API. Use 0.0.0.0 only when accessing from another device.
HOST=127.0.0.1
PORT=8787

# Optional absolute directory. Default: server/data within this project.
# Contains private accounts, sessions, favorites, history, and SDK device profile.
# HONGGUO_DATA_DIR=C:/private/hongguo-data

# Exact origins, comma separated. Never set this to * when using credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,https://localhost,capacitor://localhost

# Set true only when the API is accessed through HTTPS.
COOKIE_SECURE=false

# Cross-site HTTPS App login requires none together with COOKIE_SECURE=true.
# Native WebView cookie persistence still needs validation on target devices.
COOKIE_SAME_SITE=lax

# FFmpeg is required when a source needs SDK-provided CENC key processing.
# Install separately and add to PATH, or set the absolute executable path here.
FFMPEG_PATH=ffmpeg
